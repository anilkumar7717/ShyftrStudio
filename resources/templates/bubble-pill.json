{
  "id": "bubble-pill",
  "name": "Bubble Pill",
  "family": "Creator",
  "description": "Rounded colour pill that slides up for each caption.",
  "fontFamilies": [
    "Helvetica Neue",
    "Avenir Next",
    "Segoe UI",
    "Arial",
    "Inter",
    "DejaVu Sans"
  ],
  "fontWeight": 800,
  "sizePct": 0.05,
  "textColor": "#ff111111",
  "activeColor": "#ff7048e8",
  "outlineColor": "#00000000",
  "outlineWidthPct": 0,
  "shadowColor": "#40000000",
  "shadowOffsetPct": 0.04,
  "boxMode": "cue",
  "boxColor": "#fffff3bf",
  "boxPaddingPct": 0.42,
  "boxRadiusPct": 0.9,
  "wordEffect": "highlight",
  "maxWordsPerLine": 4,
  "maxCharsPerLine": 24,
  "maxLines": 2,
  "entry": "slideUp",
  "exit": "fade",
  "animMs": 200,
  "offsetYPct": 0.05
}